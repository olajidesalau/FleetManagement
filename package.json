{
  "name": "snow-fleet-management",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=snow-fleet-management-data --local --ip 0.0.0.0 --port 3000",
    "dev:fleet": "wrangler pages dev dist --config wrangler.fleet.jsonc --ip 0.0.0.0 --port 3000",
    "dev:fleet:d1": "wrangler pages dev dist --config wrangler.fleet.jsonc --d1=snow-fleet-management-data --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run deploy:fleet",
    "deploy:fleet": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-fleet.ps1",
    "deploy:mileage-scheduler": "npm run build && wrangler deploy --config wrangler.mileage.jsonc",
    "configure:traffic": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/configure-traffic-secrets.ps1",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "db:migrate:local": "wrangler d1 migrations apply snow-fleet-management-data --local --config wrangler.fleet.jsonc",
    "db:migrate:prod": "npm run db:migrate:fleet",
    "db:migrate:fleet:local": "wrangler d1 migrations apply snow-fleet-management-data --local --config wrangler.fleet.jsonc",
    "db:migrate:fleet": "wrangler d1 migrations apply snow-fleet-management-data --remote --config wrangler.fleet.jsonc",
    "db:seed": "wrangler d1 execute snow-fleet-management-data --local --file=./seed.sql --config wrangler.fleet.jsonc",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute snow-fleet-management-data --local --config wrangler.fleet.jsonc",
    "db:console:prod": "wrangler d1 execute snow-fleet-management-data --remote --config wrangler.fleet.jsonc",
    "git:init": "git init && git add . && git commit -m 'Initial commit'",
    "git:commit": "git add . && git commit -m",
    "git:status": "git status",
    "git:log": "git log --oneline"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "hono": "^4.11.4",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260114.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/node": "^25.0.10",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "wrangler": "^4.61.0"
  }
}
