{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snow-fleet-management",
  "compatibility_date": "2026-01-18",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snow-fleet-management-data",
      "database_id": "da30f480-a69a-43de-b99a-fcf01a0f44f0"
    }
  ]
}