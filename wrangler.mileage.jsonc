{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snow-fleet-mileage-scheduler",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-01-18",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snow-fleet-management-data",
      "database_id": "da30f480-a69a-43de-b99a-fcf01a0f44f0"
    }
  ]
}